# ─────────────────────────────────────────────────────────────────────────────
# Hermes — environment template. Copy to `.env` and fill in.
#   cp .env.example .env
# In CI these live as GitHub Actions secrets (see .github/workflows/hermes-*.yml).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → URI.
# Use the session pooler URI (port 5432) for migrations and runtime.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Optional — only if you later use the Supabase JS client for anything.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── LLM — provider-agnostic (works with ANY kind of API key) ─────────────────
# Hermes speaks three provider shapes; pick ONE block below.
#
#   LLM_PROVIDER   anthropic | openai | gemini   (optional — inferred if unset:
#                  a base URL ⇒ openai-compatible; a claude*/gemini* model ⇒
#                  that provider; otherwise anthropic)
#   LLM_API_KEY    generic key, highest precedence (or use a provider key below)
#   LLM_BASE_URL   the endpoint for OpenAI-compatible gateways / Gemini
#   LLM_BULK_MODEL / LLM_PITCH_MODEL   cheap-vs-quality models
#                  (either may be a comma list — Hermes rotates on failure)

# ── Option A — Anthropic (default) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional model overrides (defaults shown):
# LLM_BULK_MODEL=claude-haiku-4-5
# LLM_PITCH_MODEL=claude-sonnet-5

# ── Option B — 9Router (OpenAI-compatible gateway) ───────────────────────────
# 9Router is a self-hosted gateway. Run Hermes on the SAME machine as 9Router,
# or point LLM_BASE_URL at your 9Router host. Model/combo names come from your
# 9Router dashboard (http://localhost:20128/dashboard).
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-9router-key
# LLM_BASE_URL=http://localhost:20128/v1/chat/completions
# LLM_BULK_MODEL=kr/claude-haiku
# LLM_PITCH_MODEL=kr/claude-sonnet-4.5

# ── Option C — OpenRouter (100+ models, free tiers, rotation) ────────────────
# LLM_PROVIDER=openai
# OPENROUTER_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_BULK_MODEL=anthropic/claude-3.5-haiku,google/gemma-2-9b-it:free
# LLM_PITCH_MODEL=anthropic/claude-3.5-sonnet

# ── Option D — Groq / Together / Ollama / OpenAI (same shape) ────────────────
# LLM_PROVIDER=openai
# LLM_API_KEY=...
# LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions   # or Together / Ollama / OpenAI
# LLM_BULK_MODEL=llama-3.3-70b-versatile
# LLM_PITCH_MODEL=llama-3.3-70b-versatile

# ── Option E — Google Gemini ─────────────────────────────────────────────────
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# LLM_BULK_MODEL=gemini-1.5-flash
# LLM_PITCH_MODEL=gemini-1.5-pro

# ── Email delivery (free-first: Resend, else Gmail SMTP) ─────────────────────
# Resend is cleaner. Get a key at https://resend.com (free tier: 100/day).
RESEND_API_KEY=re_...
EMAIL_FROM=Hermes <onboarding@resend.dev>
EMAIL_TO=marvin@example.com

# SMTP fallback (used only if RESEND_API_KEY is empty). Gmail app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ── Reply tracking (IMAP — reply-check job) ──────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ── Behaviour knobs (sensible defaults; override only if needed) ─────────────
TZ=America/La_Paz
DAILY_TARGET=50
WEEK_CAP=250
SCRAPE_OVERSHOOT=2.0
PREVIEW_TOP_N=5

# ── Dev / ops toggles ────────────────────────────────────────────────────────
# DRY_RUN=1          # skip browser + LLM (wiring tests)
# NO_EMAIL=1         # build the xlsx but don't send it
# DISABLE_LEARNING=1 # freeze memory/weights (use shipped defaults only)
# LOG_LEVEL=debug
# OUT_DIR=./out
